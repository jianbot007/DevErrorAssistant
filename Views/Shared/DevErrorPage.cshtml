@model DevErrorAssistant.Models.DevErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DevErrorAssistant — @Model.ExceptionType</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --card-border: #334155;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-error: #ef4444;
            --accent-error-bg: rgba(239, 68, 68, 0.12);
            --accent-future: #38bdf8;
            --accent-future-bg: rgba(56, 189, 248, 0.1);
            --code-bg: #090d16;
            --code-border: #1e293b;
            --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-primary);
            font-family: var(--font-family);
            line-height: 1.6;
            padding: 2rem 1rem;
        }

        .container {
            max-width: 960px;
            margin: 0 auto;
        }

        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 1.5rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid var(--card-border);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .brand-badge {
            background-color: var(--accent-error);
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0.25rem 0.6rem;
            border-radius: 4px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .brand h1 {
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.35rem 0.75rem;
            background-color: var(--accent-error-bg);
            color: var(--accent-error);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 9999px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .exception-type {
            font-family: var(--font-mono);
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--accent-error);
            word-break: break-all;
            margin-bottom: 0.5rem;
        }

        .exception-message {
            font-size: 1rem;
            color: var(--text-primary);
            background-color: var(--code-bg);
            border: 1px solid var(--code-border);
            padding: 1rem;
            border-radius: 6px;
            white-space: pre-wrap;
            word-break: break-word;
            font-family: var(--font-mono);
        }

        .environment-notice {
            background-color: rgba(148, 163, 184, 0.1);
            border: 1px solid var(--card-border);
            border-radius: 6px;
            padding: 0.85rem 1rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-top: 1rem;
        }

        /* Collapsible Stack Trace */
        details {
            margin-top: 1rem;
            border: 1px solid var(--card-border);
            border-radius: 6px;
            overflow: hidden;
            background-color: var(--code-bg);
        }

        details summary {
            padding: 0.85rem 1rem;
            background-color: rgba(255, 255, 255, 0.03);
            cursor: pointer;
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--text-secondary);
            user-select: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        details summary:hover {
            color: var(--text-primary);
            background-color: rgba(255, 255, 255, 0.05);
        }

        details[open] summary {
            border-bottom: 1px solid var(--card-border);
        }

        .stack-trace {
            padding: 1rem;
            overflow-x: auto;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            line-height: 1.5;
            color: #cbd5e1;
            white-space: pre-wrap;
            word-break: break-all;
        }

        /* Future Implements Section */
        .future-section {
            border: 1px solid rgba(56, 189, 248, 0.3);
            background: linear-gradient(180deg, var(--card-bg) 0%, rgba(15, 23, 42, 0.8) 100%);
        }

        .future-badge {
            background-color: var(--accent-future-bg);
            color: var(--accent-future);
            border: 1px solid rgba(56, 189, 248, 0.3);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .future-field {
            margin-bottom: 1.25rem;
        }

        .future-field:last-child {
            margin-bottom: 0;
        }

        .future-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--accent-future);
            margin-bottom: 0.35rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .future-value {
            background-color: var(--code-bg);
            border: 1px dashed rgba(56, 189, 248, 0.25);
            padding: 0.85rem 1rem;
            border-radius: 6px;
            color: var(--text-secondary);
            font-size: 0.95rem;
            font-style: italic;
        }

        .ai-status-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--card-border);
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .ai-status-tag {
            background-color: rgba(100, 116, 139, 0.2);
            color: #cbd5e1;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            font-weight: 500;
        }

        footer {
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 2rem;
            padding-top: 1rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header>
            <div class="brand">
                <span class="brand-badge">MVP</span>
                <h1>DevErrorAssistant</h1>
            </div>
            <div class="status-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                HTTP 500 — Unhandled Exception
            </div>
        </header>

        <!-- Main Exception Diagnostics Card -->
        <section class="card">
            <div class="card-header">
                <h2 class="card-title">Runtime Diagnostic Details</h2>
                @if (Model.ShowDetails)
                {
                    <span style="font-size: 0.8rem; color: #4ade80;">● Development Mode Active</span>
                }
                else
                {
                    <span style="font-size: 0.8rem; color: #fbbf24;">● Production Safe Mode Active</span>
                }
            </div>

            <div class="exception-type">@Model.ExceptionType</div>
            <div class="exception-message">@Model.ExceptionMessage</div>

            @if (Model.ShowDetails && !string.IsNullOrWhiteSpace(Model.StackTrace))
            {
                <details open>
                    <summary>
                        <span>Stack Trace</span>
                        <span style="font-size: 0.8rem; font-weight: normal; color: var(--text-muted);">Click to toggle</span>
                    </summary>
                    <pre class="stack-trace">@Model.StackTrace</pre>
                </details>
            }
            else if (!Model.ShowDetails)
            {
                <div class="environment-notice">
                    <strong>Notice:</strong> Detailed stack trace and exception diagnostics are disabled in this environment for security. Configure <code>DevErrorAssistantOptions.ShowDetailedDiagnostics</code> or switch to the Development environment to inspect diagnostics.
                </div>
            }
        </section>

        <!-- Future Implements: AI Assistance Card -->
        <section class="card future-section">
            <div class="card-header">
                <h2 class="card-title">Future Implements — AI Exception Insights</h2>
                <span class="future-badge">Planned Feature</span>
            </div>

            <div class="future-field">
                <div class="future-label">English Explanation</div>
                <div class="future-value">@Model.Explanation</div>
            </div>

            <div class="future-field">
                <div class="future-label">Possible Solution</div>
                <div class="future-value">@Model.PossibleSolution</div>
            </div>

            <div class="ai-status-row">
                <span>AI Status:</span>
                <span class="ai-status-tag">@Model.AiStatus</span>
                <span style="margin-left: auto;">Offline MVP — No external AI services or API keys used</span>
            </div>
        </section>

        <!-- Footer -->
        <footer>
            DevErrorAssistant MVP &bull; ASP.NET Core Diagnostic Middleware &bull; .NET 9
        </footer>
    </div>
</body>
</html>
