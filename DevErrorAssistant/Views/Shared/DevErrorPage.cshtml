@model DevErrorAssistant.Models.DevErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DevErrorAssistant — @Model.ExceptionType</title>

    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --card-border: #334155;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-error: #ef4444;
            --accent-error-bg: rgba(239, 68, 68, 0.12);
            --accent-ai: #38bdf8;
            --accent-ai-bg: rgba(56, 189, 248, 0.1);
            --code-bg: #090d16;
            --code-border: #1e293b;
            --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-primary);
            font-family: var(--font-family);
            line-height: 1.6;
            padding: 2rem 1rem;
        }

        .container {
            max-width: 960px;
            margin: 0 auto;
        }

        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 1.5rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid var(--card-border);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .brand-badge {
            background-color: var(--accent-error);
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0.25rem 0.6rem;
            border-radius: 4px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .brand h1 {
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.35rem 0.75rem;
            background-color: var(--accent-error-bg);
            color: var(--accent-error);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 9999px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .exception-type {
            font-family: var(--font-mono);
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--accent-error);
            overflow-wrap: anywhere;
            margin-bottom: 0.5rem;
        }

        .exception-message {
            font-size: 1rem;
            color: var(--text-primary);
            background-color: var(--code-bg);
            border: 1px solid var(--code-border);
            padding: 1rem;
            border-radius: 6px;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            font-family: var(--font-mono);
        }

        .environment-notice {
            background-color: rgba(148, 163, 184, 0.1);
            border: 1px solid var(--card-border);
            border-radius: 6px;
            padding: 0.85rem 1rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-top: 1rem;
        }

        /* Stack Trace: collapsed on initial page load */
        details {
            margin-top: 1rem;
            border: 1px solid var(--card-border);
            border-radius: 6px;
            overflow: hidden;
            background-color: var(--code-bg);
        }

            details summary {
                padding: 0.85rem 1rem;
                background-color: rgba(255, 255, 255, 0.03);
                cursor: pointer;
                font-weight: 600;
                font-size: 0.95rem;
                color: var(--text-secondary);
                user-select: none;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

                details summary:hover {
                    color: var(--text-primary);
                    background-color: rgba(255, 255, 255, 0.05);
                }

            details[open] summary {
                border-bottom: 1px solid var(--card-border);
            }

        .stack-trace {
            padding: 1rem;
            overflow-x: auto;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            line-height: 1.5;
            color: #cbd5e1;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        /* AI Section */
        .ai-section {
            border: 1px solid rgba(56, 189, 248, 0.3);
            background: linear-gradient( 180deg, var(--card-bg) 0%, rgba(15, 23, 42, 0.8) 100% );
        }

        .ai-badge {
            background-color: var(--accent-ai-bg);
            color: var(--accent-ai);
            border: 1px solid rgba(56, 189, 248, 0.3);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            overflow-wrap: anywhere;
        }

        .ai-field {
            margin-bottom: 1.25rem;
        }

            .ai-field:last-child {
                margin-bottom: 0;
            }

        .ai-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--accent-ai);
            margin-bottom: 0.35rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .ai-value {
            background-color: var(--code-bg);
            border: 1px solid rgba(56, 189, 248, 0.2);
            padding: 0.85rem 1rem;
            border-radius: 6px;
            color: var(--text-primary);
            font-size: 0.95rem;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

            .ai-value.placeholder {
                border-style: dashed;
                color: var(--text-secondary);
                font-style: italic;
            }

            /* Markdown formatting inside AI responses */
            .ai-value.markdown-content {
                white-space: normal;
                line-height: 1.7;
                overflow-wrap: anywhere;
            }

                .ai-value.markdown-content p {
                    margin: 0 0 0.75rem;
                }

                    .ai-value.markdown-content p:last-child {
                        margin-bottom: 0;
                    }

                .ai-value.markdown-content h1,
                .ai-value.markdown-content h2,
                .ai-value.markdown-content h3,
                .ai-value.markdown-content h4 {
                    color: var(--accent-ai);
                    line-height: 1.4;
                    margin: 0.9rem 0 0.45rem;
                    font-size: 1rem;
                }

                    .ai-value.markdown-content h1:first-child,
                    .ai-value.markdown-content h2:first-child,
                    .ai-value.markdown-content h3:first-child,
                    .ai-value.markdown-content h4:first-child {
                        margin-top: 0;
                    }

                .ai-value.markdown-content ul,
                .ai-value.markdown-content ol {
                    margin: 0.35rem 0 0.85rem 1.4rem;
                }

                .ai-value.markdown-content li {
                    margin: 0.25rem 0;
                    padding-left: 0.15rem;
                }

                .ai-value.markdown-content code {
                    font-family: var(--font-mono);
                    font-size: 0.88em;
                    color: #bae6fd;
                    background: rgba(148, 163, 184, 0.12);
                    border: 1px solid var(--card-border);
                    border-radius: 4px;
                    padding: 0.08rem 0.28rem;
                }

                .ai-value.markdown-content pre {
                    overflow-x: auto;
                    white-space: pre;
                    padding: 0.8rem;
                    margin: 0.5rem 0 0.85rem;
                    background: #050810;
                    border: 1px solid var(--card-border);
                    border-radius: 5px;
                }

                    .ai-value.markdown-content pre code {
                        padding: 0;
                        border: 0;
                        background: transparent;
                    }

                .ai-value.markdown-content table {
                    width: 100%;
                    border-collapse: collapse;
                    margin: 0.5rem 0 0.85rem;
                    font-size: 0.9rem;
                    display: block;
                    overflow-x: auto;
                }

                .ai-value.markdown-content th,
                .ai-value.markdown-content td {
                    text-align: left;
                    vertical-align: top;
                    padding: 0.55rem;
                    border: 1px solid var(--card-border);
                }

                .ai-value.markdown-content th {
                    background: rgba(148, 163, 184, 0.12);
                }

                .ai-value.markdown-content blockquote {
                    border-left: 3px solid var(--accent-ai);
                    padding-left: 0.75rem;
                    margin: 0.5rem 0;
                    color: var(--text-secondary);
                }

        .ai-disclaimer {
            font-size: 0.8rem;
            color: var(--text-muted);
            border-left: 2px solid var(--accent-ai);
            padding-left: 0.75rem;
            margin-top: 1rem;
            font-style: italic;
        }

        .ai-status-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--card-border);
            font-size: 0.85rem;
            color: var(--text-muted);
            flex-wrap: wrap;
        }

        .ai-status-tag {
            background-color: rgba(100, 116, 139, 0.2);
            color: #cbd5e1;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            font-weight: 500;
        }

        footer {
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 2rem;
            padding-top: 1rem;
        }

        @@media (max-width: 600px) {
            body

        {
            padding: 1rem 0.65rem;
        }

        .card {
            padding: 1rem;
        }

        .brand h1 {
            font-size: 1.15rem;
        }

        .status-badge {
            font-size: 0.75rem;
        }

        }
    </style>
</head>

<body>
    <div class="container">

        <!-- Header -->
        <header>
            <div class="brand">
                <span class="brand-badge">Diagnostics</span>
                <h1>DevErrorAssistant</h1>
            </div>

            <div class="status-badge">
                <svg width="14" height="14" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                HTTP 500 — Unhandled Exception
            </div>
        </header>

        <!-- Main Exception Diagnostics Card -->
        <section class="card">
            <div class="card-header">
                <h2 class="card-title">Runtime Diagnostic Details</h2>

                @if (Model.ShowDetails)
                {
                    <span style="font-size: 0.8rem; color: #4ade80;">
                        ● Development Mode Active
                    </span>
                }
                else
                {
                    <span style="font-size: 0.8rem; color: #fbbf24;">
                        ● Production Safe Mode Active
                    </span>
                }
            </div>

            <div class="exception-type">@Model.ExceptionType</div>
            <div class="exception-message">@Model.ExceptionMessage</div>

            @if (Model.ShowDetails &&
                        !string.IsNullOrWhiteSpace(Model.StackTrace))
            {
                <!-- No "open" attribute: collapsed by default -->
                <details>
                    <summary>
                        <span>Stack Trace</span>
                        <span style="font-size: 0.8rem; font-weight: normal; color: var(--text-muted);">
                            Click to expand / collapse
                        </span>
                    </summary>

                    <pre class="stack-trace">@Model.StackTrace</pre>
                </details>
            }
            else if (!Model.ShowDetails)
            {
                <div class="environment-notice">
                    <strong>Notice:</strong>
                    Detailed stack trace and exception diagnostics are disabled
                    in this environment for security. Configure
                    <code>DevErrorAssistantOptions.ShowDetailedDiagnostics</code>
                    or switch to the Development environment to inspect diagnostics.
                </div>
            }
        </section>

        <!-- AI Assistance Card -->
        <section class="card ai-section">
            <div class="card-header">
                <h2 class="card-title" style="color: var(--accent-ai);">
                    AI Exception Insights
                </h2>

                <span class="ai-badge">
                    @if (Model.IsAiAvailable)
                    {
                        @(Model.AiProviderModel ?? "AI Suggestion")
                    }
                    else
                    {
                        <span>AI Advisory</span>
                    }
                </span>
            </div>

            <div class="ai-field">
                <div class="ai-label">English Explanation</div>
                <div class="ai-value @(Model.IsAiAvailable ? "" : "placeholder")">@Model.Explanation</div>
            </div>

            @if (Model.IsAiAvailable &&
                        !string.IsNullOrWhiteSpace(Model.LikelyCauses))
            {
                <div class="ai-field">
                    <div class="ai-label">Likely Causes</div>
                    <div class="ai-value">@Model.LikelyCauses</div>
                </div>
            }

            @if (Model.IsAiAvailable &&
                        !string.IsNullOrWhiteSpace(Model.InvestigationSteps))
            {
                <div class="ai-field">
                    <div class="ai-label">Recommended Steps</div>
                    <div class="ai-value">@Model.InvestigationSteps</div>
                </div>
            }

            <div class="ai-field">
                <div class="ai-label">Possible Solution</div>
                <div class="ai-value @(Model.IsAiAvailable ? "" : "placeholder")">@Model.PossibleSolution</div>
            </div>

            <div class="ai-disclaimer">
                @Model.AiDisclaimer
            </div>

            <div class="ai-status-row">
                <span>AI Status:</span>
                <span class="ai-status-tag">@Model.AiStatus</span>

                <span style="margin-left: auto;">
                    @if (Model.IsAiAvailable)
                    {
                        <span>AI Suggestions Active &bull; Diagnostic Advisory Only</span>
                    }
                    else
                    {
                        <span>AI Inactive &bull; No external provider calls made</span>
                    }
                </span>
            </div>
        </section>

        <!-- Footer -->
        <footer>
            DevErrorAssistant &bull; ASP.NET Core Diagnostic Middleware &bull; .NET 9
        </footer>

    </div>

    <script>
        /*
         * Lightweight Markdown renderer.
         * Uses DOM APIs and text nodes rather than innerHTML,
         * so AI output is not directly injected as executable HTML.
         */
        (function () {
            const targets = document.querySelectorAll(
                '.ai-value:not(.placeholder)'
            );

            function normalizeMarkdown(value) {
                return value
                    .replace(/\\([\\`*_{}\[\]()#+.!|<>~-])/g, '$1')
                    .replace(/<br\s*\/?\s*>/gi, '\n')
                    .replace(/\r\n?/g, '\n')
                    .trim();
            }

            function appendInline(parent, text) {
                const pattern =
                    /(`[^`]+`|\*\*[^*]+\*\*|__[^_]+__|(?<!\*)\*[^*\n]+\*(?!\*)|(?<!_)_[^_\n]+_(?!_))/g;

                let lastIndex = 0;
                let match;

                while ((match = pattern.exec(text)) !== null) {
                    if (match.index > lastIndex) {
                        parent.appendChild(
                            document.createTextNode(
                                text.slice(lastIndex, match.index)
                            )
                        );
                    }

                    const token = match[0];
                    let element;

                    if (token.startsWith('`')) {
                        element = document.createElement('code');
                        element.textContent = token.slice(1, -1);
                    } else if (
                        token.startsWith('**') ||
                        token.startsWith('__')
                    ) {
                        element = document.createElement('strong');
                        element.textContent = token.slice(2, -2);
                    } else {
                        element = document.createElement('em');
                        element.textContent = token.slice(1, -1);
                    }

                    parent.appendChild(element);
                    lastIndex = pattern.lastIndex;
                }

                if (lastIndex < text.length) {
                    parent.appendChild(
                        document.createTextNode(text.slice(lastIndex))
                    );
                }
            }

            function isTableSeparator(line) {
                return /^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?\s*$/
                    .test(line);
            }

            function tableCells(line) {
                return line.trim()
                    .replace(/^\|/, '')
                    .replace(/\|$/, '')
                    .split('|')
                    .map(cell => cell.trim());
            }

            function renderMarkdown(element) {
                const source = normalizeMarkdown(
                    element.textContent || ''
                );

                if (!source) return;

                const lines = source.split('\n');
                const fragment = document.createDocumentFragment();
                let i = 0;

                while (i < lines.length) {
                    const line = lines[i];

                    if (!line.trim()) {
                        i++;
                        continue;
                    }

                    // Fenced code blocks
                    if (/^\s*```/.test(line)) {
                        i++;

                        const codeLines = [];

                        while (
                            i < lines.length &&
                            !/^\s*```/.test(lines[i])
                        ) {
                            codeLines.push(lines[i]);
                            i++;
                        }

                        if (i < lines.length) i++;

                        const pre = document.createElement('pre');
                        const code = document.createElement('code');

                        code.textContent = codeLines.join('\n');
                        pre.appendChild(code);
                        fragment.appendChild(pre);
                        continue;
                    }

                    // Markdown tables
                    if (
                        i + 1 < lines.length &&
                        line.includes('|') &&
                        isTableSeparator(lines[i + 1])
                    ) {
                        const table = document.createElement('table');
                        const thead = document.createElement('thead');
                        const headerRow = document.createElement('tr');

                        tableCells(line).forEach(cell => {
                            const th = document.createElement('th');
                            appendInline(th, cell);
                            headerRow.appendChild(th);
                        });

                        thead.appendChild(headerRow);
                        table.appendChild(thead);

                        i += 2;

                        const tbody = document.createElement('tbody');

                        while (
                            i < lines.length &&
                            lines[i].trim() &&
                            lines[i].includes('|')
                        ) {
                            const row = document.createElement('tr');

                            tableCells(lines[i]).forEach(cell => {
                                const td = document.createElement('td');
                                appendInline(td, cell);
                                row.appendChild(td);
                            });

                            tbody.appendChild(row);
                            i++;
                        }

                        table.appendChild(tbody);
                        fragment.appendChild(table);
                        continue;
                    }

                    // Headings
                    const heading = line.match(
                        /^\s*(#{1,4})\s+(.+)$/
                    );

                    if (heading) {
                        const headingElement = document.createElement(
                            'h' + heading[1].length
                        );

                        appendInline(headingElement, heading[2]);
                        fragment.appendChild(headingElement);
                        i++;
                        continue;
                    }

                    // Blockquotes
                    if (/^\s*>\s?/.test(line)) {
                        const quote = document.createElement('blockquote');
                        const paragraph = document.createElement('p');

                        appendInline(
                            paragraph,
                            line.replace(/^\s*>\s?/, '')
                        );

                        quote.appendChild(paragraph);
                        fragment.appendChild(quote);
                        i++;
                        continue;
                    }

                    // Ordered and unordered lists
                    const listMatch = line.match(
                        /^\s*([-*+]\s+|\d+[.)]\s+)(.*)$/
                    );

                    if (listMatch) {
                        const ordered = /^\s*\d/.test(line);
                        const list = document.createElement(
                            ordered ? 'ol' : 'ul'
                        );

                        while (i < lines.length) {
                            const itemMatch = lines[i].match(
                                /^\s*([-*+]\s+|\d+[.)]\s+)(.*)$/
                            );

                            if (
                                !itemMatch ||
                                /^\s*\d/.test(lines[i]) !== ordered
                            ) {
                                break;
                            }

                            const li = document.createElement('li');
                            appendInline(li, itemMatch[2]);
                            list.appendChild(li);
                            i++;
                        }

                        fragment.appendChild(list);
                        continue;
                    }

                    // Paragraphs
                    const paragraph = document.createElement('p');

                    appendInline(
                        paragraph,
                        line.replace(/\s{2,}$/g, '')
                    );

                    i++;

                    while (
                        i < lines.length &&
                        lines[i].trim() &&
                        !/^\s*(```|#{1,4}\s|>|[-*+]\s+|\d+[.)]\s+)/
                            .test(lines[i]) &&
                        !(
                            i + 1 < lines.length &&
                            lines[i].includes('|') &&
                            isTableSeparator(lines[i + 1])
                        )
                    ) {
                        paragraph.appendChild(
                            document.createElement('br')
                        );

                        appendInline(paragraph, lines[i]);
                        i++;
                    }

                    fragment.appendChild(paragraph);
                }

                element.textContent = '';
                element.classList.add('markdown-content');
                element.appendChild(fragment);
            }

            targets.forEach(renderMarkdown);
        })();
    </script>
</body>
</html>